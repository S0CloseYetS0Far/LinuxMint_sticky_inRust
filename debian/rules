#!/usr/bin/make -f

DEB_VERSION := $(shell dpkg-parsechangelog | egrep '^Version:' | cut -f 2 -d ' ')

%:
	dh $@

override_dh_auto_test:
	cargo test --release --locked

# Inject version number in the text files (the program takes its version from Cargo.toml)
override_dh_installdeb:
	dh_installdeb
	for pkg in $$(dh_listpackages -a); do \
		grep -rlI __DEB_VERSION__ debian/$$pkg | xargs -r sed -i -e s/__DEB_VERSION__/$(DEB_VERSION)/g; \
	done
